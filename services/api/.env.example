FLOWNOTE_ENV=local
FLOWNOTE_API_HOST=127.0.0.1
FLOWNOTE_API_PORT=5184
FLOWNOTE_DATABASE_URL=sqlite:///./data/flownote.sqlite3
FLOWNOTE_TEST_DATABASE_URL=sqlite:///./data/flownote.test.sqlite3
FLOWNOTE_DATABASE_ECHO=false
FLOWNOTE_STORAGE_ROOT=./storage
FLOWNOTE_FIELD_COMMENT_ATTACHMENT_MAX_BYTES=20971520
FLOWNOTE_CONTROLLED_COPY_MAX_BYTES=524288000
FLOWNOTE_CONTROLLED_COPY_TICKET_EXPIRES_SECONDS=60
FLOWNOTE_ANDROID_VIEW_GRANT_EXPIRES_SECONDS=60
FLOWNOTE_ANDROID_VIEW_AUTO_CLOSE_SECONDS=300
FLOWNOTE_ANDROID_VIEW_MAX_BYTES=52428800
FLOWNOTE_ANDROID_VIEW_MAX_TEXT_BYTES=5242880
FLOWNOTE_ANDROID_VIEW_MAX_PDF_PAGES=200
FLOWNOTE_SESSION_COOKIE_NAME=flownote_session
FLOWNOTE_ACCESS_TOKEN_SECRET=replace-with-a-long-site-specific-secret
FLOWNOTE_ACCESS_TOKEN_EXPIRES_MINUTES=480
FLOWNOTE_REFRESH_TOKEN_EXPIRES_DAYS=14
FLOWNOTE_CUSTOMER_SCOPE=DEFAULT
FLOWNOTE_SITE_SCOPE=DEFAULT
FLOWNOTE_FIELD_COMMENT_INDEPENDENT_REVIEW_REQUIRED=true
FLOWNOTE_RESTORE_FAULT_CODE=
FLOWNOTE_RESTORE_BLOCK_REASON=
FLOWNOTE_RESTORE_PILOT_RUN_ID=
FLOWNOTE_RESTORE_BACKUP_SET_ID=
FLOWNOTE_RESTORE_APPROVAL_ID=
FLOWNOTE_RESTORE_RESPONSIBLE_OWNER=
FLOWNOTE_AI_EXTERNAL_CALL_ENABLED=false
FLOWNOTE_AI_READINESS_GATE_ENABLED=true
FLOWNOTE_AI_PROVIDER=UNCONFIGURED
FLOWNOTE_AI_MODEL=UNCONFIGURED
FLOWNOTE_AI_CUSTOMER_SCOPE=DEFAULT
FLOWNOTE_AI_SITE_SCOPE=DEFAULT
FLOWNOTE_AI_PROVIDER_EXCERPT_MAX_CHARS=600
FLOWNOTE_AI_PROVIDER_MAX_SOURCES=12
FLOWNOTE_AI_PROVIDER_ADAPTER_MODE=DISABLED
FLOWNOTE_AI_FAKE_SCENARIOS=SUCCESS
FLOWNOTE_AI_PROVIDER_ENDPOINT=
FLOWNOTE_AI_NETWORK_TEST_SCOPE_ENABLED=false
FLOWNOTE_AI_NETWORK_TIMEOUT_SECONDS=30
FLOWNOTE_AI_PROVIDER_MAX_ATTEMPTS=3
FLOWNOTE_AI_PROVIDER_RESPONSE_MAX_BYTES=65536
FLOWNOTE_AI_RETENTION_SCHEDULER_ENABLED=true
FLOWNOTE_AI_RETENTION_SCHEDULER_INTERVAL_SECONDS=3600
