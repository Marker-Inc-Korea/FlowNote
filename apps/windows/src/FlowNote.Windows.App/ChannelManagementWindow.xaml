<Window x:Class="FlowNote.Windows.App.ChannelManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="채널 관리"
        Width="1040"
        Height="650"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <StackPanel>
                <TextBlock Text="채널 관리"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12"
                            Background="{StaticResource PanelMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="새 채널"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="라인, 설비, 공정, 작업조, 인수인계 채널"
                                       Margin="0,4,0,10"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="ChannelNameTextBox"
                                     Height="30"
                                     Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="채널 이름" />
                            <ComboBox x:Name="ChannelTypeComboBox"
                                      Height="30"
                                      Margin="0,0,0,8"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="라인" Tag="LINE" />
                                <ComboBoxItem Content="설비" Tag="EQUIPMENT" />
                                <ComboBoxItem Content="공정" Tag="PROCESS" />
                                <ComboBoxItem Content="작업조" Tag="WORK_GROUP" />
                                <ComboBoxItem Content="인수인계" Tag="HANDOVER" />
                            </ComboBox>
                            <TextBox x:Name="ChannelSourceIdTextBox"
                                     Height="30"
                                     Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="라인/설비/공정/작업조 코드" />
                            <TextBox x:Name="ChannelDescriptionTextBox"
                                     Height="64"
                                     Margin="0,0,0,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="채널 설명" />
                            <Button Height="32"
                                    Content="채널 만들기"
                                    Click="CreateChannelButton_Click" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ChannelGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionChanged="ChannelGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="유형" Binding="{Binding ChannelTypeLabel}" Width="74" />
                            <DataGridTextColumn Header="채널" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12"
                            Background="{StaticResource PanelMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MemberUserIdTextBox"
                                     Height="30"
                                     Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="추가할 user_id" />
                            <ComboBox x:Name="MemberRoleComboBox"
                                      Grid.Column="1"
                                      Height="30"
                                      Margin="0,0,8,0"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="소유자" Tag="OWNER" />
                                <ComboBoxItem Content="관리자" Tag="MANAGER" />
                                <ComboBoxItem Content="멤버" Tag="MEMBER" />
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Content="멤버 추가"
                                    Click="AddMemberButton_Click" />
                            <Button Grid.Column="3"
                                    Height="30"
                                    Content="제외"
                                    Click="RemoveMemberButton_Click" />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="MemberGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="사용자 ID" Binding="{Binding UserId}" Width="180" />
                            <DataGridTextColumn Header="역할" Binding="{Binding MemberRoleLabel}" Width="100" />
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="90" />
                            <DataGridTextColumn Header="마지막 읽음" Binding="{Binding LastReadAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                            <DataGridTextColumn Header="멤버 ID" Binding="{Binding MemberId}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Width="96"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="새로고침"
                    Click="RefreshButton_Click" />
            <Button Width="84"
                    Height="34"
                    Content="닫기"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
