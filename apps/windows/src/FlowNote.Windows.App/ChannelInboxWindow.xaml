<Window x:Class="FlowNote.Windows.App.ChannelInboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="채널 수신함"
        Width="1060"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="채널 수신함"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.RowSpan="2"
                        Grid.Column="1"
                        Width="96"
                        Height="32"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="새로고침"
                        Click="RefreshButton_Click" />

                <Border Grid.Row="1"
                        Margin="0,4,0,0"
                        Padding="8,3"
                        Background="{StaticResource PanelMutedBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ScrollViewer MaxHeight="34"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="StatusTextBlock"
                                   FontSize="11"
                                   LineHeight="15"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Height="42"
                            Padding="12,0"
                            Background="{StaticResource PanelMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="내 채널"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Border>
                    <DataGrid x:Name="ChannelGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionChanged="ChannelGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="유형" Binding="{Binding ChannelTypeLabel}" Width="72" />
                            <DataGridTextColumn Header="채널" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Height="42"
                                Padding="12,0"
                                Background="{StaticResource PanelMutedBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="채널 메시지"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="UnreadOnlyCheckBox"
                                              Margin="0,0,10,0"
                                              Content="읽지 않음만"
                                              VerticalAlignment="Center"
                                              Checked="UnreadOnlyCheckBox_Changed"
                                              Unchecked="UnreadOnlyCheckBox_Changed" />
                                    <Button Width="92"
                                            Height="30"
                                            Content="읽음 처리"
                                            Click="MarkSelectedReadButton_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataGrid x:Name="NotificationGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="읽음" Width="54">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding ReadLabel}"
                                                  AutomationProperties.Name="{Binding ReadLabel}">
                                                <Border x:Name="ReadStateIcon"
                                                        Width="20"
                                                        Height="20"
                                                        Background="#F1F5F9"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <Grid>
                                                        <Path x:Name="UnknownStateMark"
                                                              Data="M 6,10 L 14,10"
                                                              Stroke="#64748B"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" />
                                                        <Ellipse x:Name="UnreadStateMark"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="#2563EB"
                                                                 Visibility="Collapsed" />
                                                        <Path x:Name="ReadStateMark"
                                                              Data="M 5,10 L 8.5,13 L 15,6.5"
                                                              Stroke="#15803D"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Read}" Value="False">
                                                    <Setter TargetName="ReadStateIcon" Property="Background" Value="#EFF6FF" />
                                                    <Setter TargetName="ReadStateIcon" Property="BorderBrush" Value="#93C5FD" />
                                                    <Setter TargetName="UnknownStateMark" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="UnreadStateMark" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Read}" Value="True">
                                                    <Setter TargetName="ReadStateIcon" Property="Background" Value="#F0FDF4" />
                                                    <Setter TargetName="ReadStateIcon" Property="BorderBrush" Value="#86EFAC" />
                                                    <Setter TargetName="UnknownStateMark" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ReadStateMark" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="채널" Binding="{Binding ChannelName}" Width="150" />
                                <DataGridTextColumn Header="유형" Binding="{Binding MessageTypeLabel}" Width="110" />
                                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="180" />
                                <DataGridTextColumn Header="원천 링크" Binding="{Binding SourceLinkText}" Width="230" />
                                <DataGridTextColumn Header="시간" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                                <DataGridTextColumn Header="내용" Binding="{Binding Body}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Height="42"
                                Padding="12,0"
                                Background="{StaticResource PanelMutedBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="인수인계"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Width="76"
                                            Height="30"
                                            Margin="0,0,6,0"
                                            Content="읽음"
                                            Click="ReadReceiptButton_Click" />
                                    <Button Width="76"
                                            Height="30"
                                            Margin="0,0,6,0"
                                            Content="확인"
                                            Click="AckReceiptButton_Click" />
                                    <Button Width="76"
                                            Height="30"
                                            Margin="0,0,6,0"
                                            Content="보류"
                                            Click="HoldReceiptButton_Click" />
                                    <Button Width="88"
                                            Height="30"
                                            Content="후속 필요"
                                            Click="FollowUpReceiptButton_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataGrid x:Name="HandoverGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="100" />
                                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="180" />
                                <DataGridTextColumn Header="원천 링크" Binding="{Binding SourceLinkText}" Width="230" />
                                <DataGridTextColumn Header="발송" Binding="{Binding SentAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                                <DataGridTextColumn Header="내용" Binding="{Binding Body}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Width="122"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="원천 정보 복사"
                    Click="CopySourceButton_Click" />
            <Button Width="150"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="후속 코멘트 저장"
                    ToolTip="선택한 인수인계를 원천으로 보존하는 현장 코멘트를 저장합니다."
                    Click="FollowUpFieldCommentButton_Click" />
            <Button Width="84"
                    Height="34"
                    Content="닫기"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
