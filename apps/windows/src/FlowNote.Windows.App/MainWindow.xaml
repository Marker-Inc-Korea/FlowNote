<Window x:Class="FlowNote.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowNote"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="HeaderTopMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBrush}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="HeaderSubmenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="MinWidth" Value="184" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Width="210"
                            VerticalAlignment="Center">
                    <TextBlock Text="FlowNote"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="현장 문서와 작업 지식 관리"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        MaxWidth="230"
                        Margin="12,0,0,0"
                        Padding="10,5"
                        Background="{StaticResource PanelMutedBrush}"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SignedInUserTextBlock"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Border>

                <ComboBox x:Name="DocumentStatusComboBox"
                          Visibility="Collapsed"
                          SelectedIndex="0">
                    <ComboBoxItem Content="작업중" Tag="WORKING" />
                    <ComboBoxItem Content="검토중" Tag="IN_REVIEW" />
                    <ComboBoxItem Content="보관" Tag="ARCHIVED" />
                </ComboBox>

                <Menu Margin="0"
                      Padding="0"
                      Background="Transparent"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
                    <MenuItem x:Name="AdministrationActionsGroup"
                              Header="계정 · 단말  ▾"
                              Style="{StaticResource HeaderTopMenuItemStyle}">
                        <MenuItem x:Name="UserManagementButton"
                                  Header="사용자 관리"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="UserManagementButton_Click" />
                        <MenuItem x:Name="TerminalDeviceManagementButton"
                                  Header="승인 단말 관리"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="TerminalDeviceManagementButton_Click" />
                    </MenuItem>

                    <MenuItem Header="알림 · 채널  ▾"
                              Style="{StaticResource HeaderTopMenuItemStyle}">
                        <MenuItem x:Name="NotificationButton"
                                  Header="알림함"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="NotificationButton_Click" />
                        <MenuItem x:Name="NotificationCursorResetButton"
                                  Header="알림 위치 초기화"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="NotificationCursorResetButton_Click" />
                        <Separator />
                        <MenuItem x:Name="ChannelInboxButton"
                                  Header="채널함"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="ChannelInboxButton_Click" />
                        <MenuItem x:Name="ChannelManagementButton"
                                  Header="채널 관리"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="ChannelManagementButton_Click" />
                        <MenuItem x:Name="HandoverStatusButton"
                                  Header="인수인계 확인 현황"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="HandoverStatusButton_Click" />
                    </MenuItem>

                    <MenuItem Header="현장 운영  ▾"
                              Style="{StaticResource HeaderTopMenuItemStyle}">
                        <MenuItem x:Name="ChangeHistoryButton"
                                  Header="변경 이력"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="ChangeHistoryButton_Click" />
                        <MenuItem x:Name="OperationalReadinessButton"
                                  Header="운영 준비도"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="OperationalReadinessButton_Click" />
                        <MenuItem Header="로컬 이력"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="HistoryButton_Click" />
                        <MenuItem x:Name="WorkSequenceAdminButton"
                                  Header="작업순서 관리"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="WorkSequenceAdminButton_Click" />
                        <MenuItem x:Name="WorkSequenceDashboardButton"
                                  Header="작업순서 현황판"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="WorkSequenceTvButton_Click" />
                        <Separator />
                        <MenuItem x:Name="FieldCommentReviewButton"
                                  Header="코멘트 검토"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="FieldCommentReviewButton_Click" />
                        <MenuItem x:Name="ReportDraftButton"
                                  Header="보고서"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="ReportDraftButton_Click" />
                    </MenuItem>

                    <MenuItem Header="AI  ▾"
                              Style="{StaticResource HeaderTopMenuItemStyle}">
                        <MenuItem x:Name="AISearchQualityButton"
                                  Header="AI 점검"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="AISearchQualityButton_Click" />
                        <MenuItem x:Name="AIGroundTruthButton"
                                  Header="AI 정답셋"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="AIGroundTruthButton_Click" />
                        <MenuItem x:Name="AIOperationsButton"
                                  Header="AI 운영"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="AIOperationsButton_Click" />
                    </MenuItem>

                    <MenuItem Header="문서 운영  ▾"
                              Style="{StaticResource HeaderTopMenuItemStyle}">
                        <MenuItem x:Name="NewFolderButton"
                                  Header="새 폴더"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="NewFolderButton_Click" />
                        <MenuItem x:Name="RegisterDocumentButton"
                                  Header="문서 등록"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="RegisterDocumentButton_Click" />
                        <MenuItem x:Name="UploadFileButton"
                                  Header="파일 업로드"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="UploadFileButton_Click" />
                        <Separator />
                        <MenuItem x:Name="ApplyDocumentStatusButton"
                                  Header="문서 상태 변경"
                                  Style="{StaticResource HeaderSubmenuItemStyle}">
                            <MenuItem Header="작업중으로 변경"
                                      Tag="WORKING"
                                      Style="{StaticResource HeaderSubmenuItemStyle}"
                                      Click="ApplyDocumentStatusButton_Click" />
                            <MenuItem Header="검토중으로 변경"
                                      Tag="IN_REVIEW"
                                      Style="{StaticResource HeaderSubmenuItemStyle}"
                                      Click="ApplyDocumentStatusButton_Click" />
                            <MenuItem Header="보관으로 변경"
                                      Tag="ARCHIVED"
                                      Style="{StaticResource HeaderSubmenuItemStyle}"
                                      Click="ApplyDocumentStatusButton_Click" />
                        </MenuItem>
                        <MenuItem x:Name="PublishDocumentButton"
                                  Header="검토·공개 승인 작업함"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="PublishDocumentButton_Click" />
                        <Separator />
                        <MenuItem x:Name="FileWatchButton"
                                  Header="파일 감시"
                                  Style="{StaticResource HeaderSubmenuItemStyle}"
                                  Click="FileWatchButton_Click" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="18,8"
                Background="{StaticResource PanelMutedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="RolePriorityTextBlock"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="PermissionGuideTextBlock"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="QuickTaskOneButton"
                            MinWidth="118"
                            Height="32"
                            Padding="10,0"
                            Click="QuickTaskButton_Click" />
                    <Button x:Name="QuickTaskTwoButton"
                            MinWidth="118"
                            Height="32"
                            Margin="6,0,0,0"
                            Padding="10,0"
                            Click="QuickTaskButton_Click" />
                    <Button x:Name="QuickTaskThreeButton"
                            MinWidth="118"
                            Height="32"
                            Margin="6,0,0,0"
                            Padding="10,0"
                            Click="QuickTaskButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="282" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Height="48"
                            Padding="14,0"
                            Background="{StaticResource PanelMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Padding="7,2"
                                    Background="#FFF7DF"
                                    BorderBrush="#E8C36A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    VerticalAlignment="Center">
                                <TextBlock Text="폴더"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#9A6700" />
                            </Border>
                            <TextBlock Text="폴더 탐색"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TreeView ItemsSource="{Binding Folders}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseDoubleClick="FolderTree_PreviewMouseDoubleClick"
                              Margin="10,8,8,10"
                              BorderThickness="0"
                              Background="{StaticResource PanelBackgroundBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid MinHeight="28"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding Path, StringFormat=폴더 위치: {0}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0"
                                             Width="18"
                                             Height="16"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center">
                                        <Canvas Width="20" Height="17">
                                            <Path Data="M 1,4 L 7.5,4 L 9.5,6 L 19,6 L 19,16 L 1,16 Z"
                                                  Fill="#F4B740"
                                                  Stroke="#C98200"
                                                  StrokeThickness="1" />
                                            <Path Data="M 1,7 L 19,7"
                                                  Stroke="#FFD778"
                                                  StrokeThickness="1" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Name}"
                                               Grid.Column="1"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Margin="8,0,2,0"
                                            Padding="6,1"
                                            Background="#FFF7DF"
                                            BorderBrush="#F0D89D"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="폴더"
                                                   FontSize="10"
                                                   Foreground="#9A6700" />
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2"
                  x:Name="FileListDropZone"
                  AllowDrop="True"
                  DragEnter="FileListDropZone_DragEnter"
                  DragLeave="FileListDropZone_DragLeave"
                  DragOver="FileListDropZone_DragOver"
                  Drop="FileListDropZone_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="검색"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="DocumentSearchTextBox"
                                 Grid.Column="1"
                                 Height="30"
                                 ToolTip="파일명, 제목, 태그, 사용자, 최근 코멘트 검색"
                                 TextChanged="DocumentSearchTextBox_TextChanged"
                                 KeyDown="DocumentSearchTextBox_KeyDown"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="등록 태그"
                                   Margin="14,0,8,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TagInputTextBox"
                                 Grid.Column="3"
                                 Height="30"
                                 ToolTip="쉼표로 여러 태그를 입력"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="4"
                                   Text="상태"
                                   Margin="12,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="DocumentFilterComboBox"
                                  Grid.Column="5"
                                  Height="30"
                                  Margin="8,0,0,0"
                                  SelectedIndex="0"
                                  SelectionChanged="DocumentFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="전체 상태" Tag="ALL" />
                            <ComboBoxItem Content="작업중" Tag="WORKING" />
                            <ComboBoxItem Content="검토중" Tag="IN_REVIEW" />
                            <ComboBoxItem Content="공개" Tag="PUBLISHED" />
                            <ComboBoxItem Content="보관" Tag="ARCHIVED" />
                        </ComboBox>
                        <Button Grid.Column="6"
                                Height="30"
                                Margin="8,0,0,0"
                                Padding="10,0"
                                Content="선택 문서 열기"
                                Click="OpenSelectedDocumentButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Background="{StaticResource PanelMutedBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,0">
                    <DockPanel>
                        <TextBlock x:Name="DocumentListHintTextBlock"
                                   DockPanel.Dock="Right"
                                   Text="유형별 파일 아이콘, 태그, 상태, 버전, 사용자, 생성시간"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="DocumentListTitleTextBlock"
                                       Text="파일 · 문서 목록"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0"
                                    Padding="7,2"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock Text="파일"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        x:Name="FileListPanel"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DataGrid x:Name="DocumentGrid"
                              ItemsSource="{Binding Documents}"
                              MouseDoubleClick="DocumentGrid_MouseDoubleClick"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeight="44"
                              ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="파일 이름"
                                                    Width="2.4*"
                                                    MinWidth="230"
                                                    SortMemberPath="FileName"
                                                    ClipboardContentBinding="{Binding FileName}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,0,4,0"
                                              ToolTip="{Binding Title, StringFormat=문서 제목: {0}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28"
                                                  Height="30"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding DocumentType, StringFormat=파일 유형: {0}}">
                                                <Viewbox Stretch="Uniform">
                                                    <Canvas Width="28" Height="30">
                                                        <Path x:Name="FileIconBody"
                                                              Data="M 3,1 L 18,1 L 25,8 L 25,29 L 3,29 Z"
                                                              Fill="#EFF6FF"
                                                              Stroke="#2563EB"
                                                              StrokeThickness="1.2" />
                                                        <Path x:Name="FileIconFold"
                                                              Data="M 18,1 L 18,8 L 25,8"
                                                              Fill="Transparent"
                                                              Stroke="#2563EB"
                                                              StrokeThickness="1.2" />
                                                        <Border x:Name="FileIconBand"
                                                                Canvas.Left="4"
                                                                Canvas.Top="15"
                                                                Width="20"
                                                                Height="10"
                                                                Background="#2563EB"
                                                                CornerRadius="2">
                                                            <TextBlock x:Name="FileIconLabel"
                                                                       Text="{Binding DocumentType}"
                                                                       Padding="1,0"
                                                                       FontSize="6.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"
                                                                       TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DocumentType}" Value="PDF">
                                                <Setter TargetName="FileIconBody" Property="Fill" Value="#FEF2F2" />
                                                <Setter TargetName="FileIconBody" Property="Stroke" Value="#DC2626" />
                                                <Setter TargetName="FileIconFold" Property="Stroke" Value="#DC2626" />
                                                <Setter TargetName="FileIconBand" Property="Background" Value="#DC2626" />
                                                <Setter TargetName="FileIconLabel" Property="Text" Value="PDF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DocumentType}" Value="Image">
                                                <Setter TargetName="FileIconBody" Property="Fill" Value="#F0FDFA" />
                                                <Setter TargetName="FileIconBody" Property="Stroke" Value="#0F766E" />
                                                <Setter TargetName="FileIconFold" Property="Stroke" Value="#0F766E" />
                                                <Setter TargetName="FileIconBand" Property="Background" Value="#0F766E" />
                                                <Setter TargetName="FileIconLabel" Property="Text" Value="IMG" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DocumentType}" Value="Spreadsheet">
                                                <Setter TargetName="FileIconBody" Property="Fill" Value="#F0FDF4" />
                                                <Setter TargetName="FileIconBody" Property="Stroke" Value="#15803D" />
                                                <Setter TargetName="FileIconFold" Property="Stroke" Value="#15803D" />
                                                <Setter TargetName="FileIconBand" Property="Background" Value="#15803D" />
                                                <Setter TargetName="FileIconLabel" Property="Text" Value="XLS" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DocumentType}" Value="Text">
                                                <Setter TargetName="FileIconBody" Property="Fill" Value="#F8FAFC" />
                                                <Setter TargetName="FileIconBody" Property="Stroke" Value="#475569" />
                                                <Setter TargetName="FileIconFold" Property="Stroke" Value="#475569" />
                                                <Setter TargetName="FileIconBand" Property="Background" Value="#475569" />
                                                <Setter TargetName="FileIconLabel" Property="Text" Value="TXT" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="태그"
                                                Binding="{Binding TagText}"
                                                Width="*"
                                                MinWidth="80"
                                                MaxWidth="140" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="84" />
                            <DataGridTextColumn Header="버전" Binding="{Binding VersionLabel}" Width="58" />
                            <DataGridTextColumn Header="공개" Binding="{Binding PublishedVersionLabel}" Width="58" />
                            <DataGridTextColumn Header="사용자" Binding="{Binding UpdatedBy}" Width="105" />
                            <DataGridTemplateColumn Header="생성 시간"
                                                    Width="165"
                                                    MinWidth="155"
                                                    SortMemberPath="UpdatedAt"
                                                    ClipboardContentBinding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                                   Margin="8,0,4,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SyncStateTextBlock"
                           Margin="0,3,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
