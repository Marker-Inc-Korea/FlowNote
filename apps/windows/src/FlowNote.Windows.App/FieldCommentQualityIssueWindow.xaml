<Window x:Class="FlowNote.Windows.App.FieldCommentQualityIssueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldComment 서버 품질 이슈"
        Width="1040"
        Height="560"
        MinWidth="800"
        MinHeight="400"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryTextBlock"
                   Margin="0,0,0,10"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}" />
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="품질 이슈" Binding="{Binding IssueType}" Width="190" />
                <DataGridTextColumn Header="FieldComment" Binding="{Binding CommentId}" Width="220" />
                <DataGridTextColumn Header="보고서" Binding="{Binding ReportId}" Width="190" />
                <DataGridTextColumn Header="경과일" Binding="{Binding AgeDays}" Width="68" />
                <DataGridTextColumn Header="우선 처리 근거" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2"
                Width="100"
                Height="32"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Content="닫기"
                IsCancel="True" />
    </Grid>
</Window>
