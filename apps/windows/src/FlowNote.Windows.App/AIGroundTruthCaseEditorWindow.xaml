<Window x:Class="FlowNote.Windows.App.AIGroundTruthCaseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ground-truth 사례·원천 구성" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Padding="10" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <TextBox x:Name="CaseKeyTextBox" Margin="3" ToolTip="중복 없는 case key"/>
                <ComboBox Grid.Column="1" x:Name="CategoryComboBox" Margin="3"/>
                <ComboBox Grid.Column="2" x:Name="ScenarioComboBox" Margin="3"/>
                <TextBox Grid.Column="3" x:Name="QuestionTextBox" Margin="3" ToolTip="검증 질문"/>
                <ComboBox Grid.Row="1" x:Name="OutcomeComboBox" Margin="3"><ComboBoxItem Content="SUFFICIENT"/><ComboBoxItem Content="INSUFFICIENT_EVIDENCE"/></ComboBox>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ClassificationComboBox" Margin="3"><ComboBoxItem Content="ANONYMOUS_FIELD"/><ComboBoxItem Content="PILOT"/><ComboBoxItem Content="TEST"/><ComboBoxItem Content="SYNTHETIC"/></ComboBox>
                <DatePicker Grid.Row="1" Grid.Column="2" x:Name="AsOfDatePicker" Margin="3"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal"><TextBlock Text="허용 순위" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="RankMinTextBox" Width="45" Text="1" Margin="3"/><TextBlock Text="~" VerticalAlignment="Center"/><TextBox x:Name="RankMaxTextBox" Width="45" Text="20" Margin="3"/></StackPanel>
                <TextBox Grid.Row="2" Grid.ColumnSpan="4" x:Name="ProvenanceTextBox" Margin="3" Text="비민감 원천을 운영자가 직접 검토해 구성"/>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <Button Width="120" Margin="3" Content="선택 후보 포함" Click="AddIncludedButton_Click"/>
                    <Button Width="120" Margin="3" Content="수동 제외 추가" Click="AddExcludedButton_Click"/>
                    <Button Width="110" Margin="3" Content="선택 제거" Click="RemoveReferenceButton_Click"/>
                    <Button Width="120" Margin="20,3,3,3" Content="사례 1차 등록" Click="CreateCaseButton_Click"/>
                    <Button Width="120" Margin="3" Content="선택 사례 2차 승인" Click="SecondApproveButton_Click"/>
                    <Button Width="90" Margin="20,3,3,3" Content="새로 고침" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="CandidateGrid" ItemsSource="{Binding Candidates}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns><DataGridTextColumn Header="원천" Binding="{Binding SourceType}" Width="160"/><DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="source ID" Binding="{Binding SourceId}" Width="210"/></DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
                <DataGrid x:Name="CasePoolGrid" ItemsSource="{Binding CasePool}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns><DataGridTextColumn Header="case key" Binding="{Binding CaseKey}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding ApprovalStatus}" Width="130"/></DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <ComboBox x:Name="ExcludedSourceTypeComboBox" Margin="2"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal"><TextBox x:Name="ExcludedSourceIdTextBox" Width="210" Margin="2" ToolTip="제외할 실제 source ID"/><TextBox x:Name="ExcludedSourceVersionIdTextBox" Width="198" Margin="2" ToolTip="선택적 source version ID"/></StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBox x:Name="ExclusionReasonTextBox" Width="190" Margin="2" ToolTip="서버 제외 사유 코드"/><TextBox x:Name="RationaleTextBox" Width="210" Margin="2" Text="운영 정책상 제외 원천"/></StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <DataGrid Grid.Row="2" x:Name="ReferenceGrid" ItemsSource="{Binding References}" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="구분" Binding="{Binding Kind}" Width="70"/><DataGridTextColumn Header="원천" Binding="{Binding SourceType}" Width="190"/><DataGridTextColumn Header="source ID" Binding="{Binding SourceId}" Width="*"/><DataGridTextColumn Header="version" Binding="{Binding SourceVersionId}" Width="210"/><DataGridTextColumn Header="사유" Binding="{Binding Rationale}" Width="220"/></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Margin="2,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
    </Grid>
</Window>
