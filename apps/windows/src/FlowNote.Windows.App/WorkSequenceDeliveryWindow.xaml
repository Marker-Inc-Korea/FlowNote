<Window x:Class="FlowNote.Windows.App.WorkSequenceDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업순서 알림 후보 전달"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="알림 후보" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,10" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="현재 작업판 revision과 일치하는 후보만 전달할 수 있습니다." />
                    <Button Height="32" Content="후보와 채널 새로고침"
                            AutomationProperties.Name="알림 후보와 전달 가능 채널 새로고침"
                            Click="RefreshButton_Click" />
                </StackPanel>
                <ListBox x:Name="CandidateListBox" Margin="0,10,0,0"
                         ItemsSource="{Binding Candidates}" DisplayMemberPath="DisplayText"
                         AutomationProperties.Name="작업순서 알림 후보 목록"
                         SelectionChanged="PreviewSelectionChanged" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="12" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="전달 전 확인" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="권한 없는 채널은 목록에 표시하지 않습니다. 목록에 필요한 채널이 없으면 채널 관리자에게 소유자 또는 관리자 역할을 요청하세요." />
                        <TextBlock Text="대상 채널" />
                        <ComboBox x:Name="ChannelComboBox" Height="32" Margin="0,4,0,8"
                                  ItemsSource="{Binding Channels}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="전달 대상 업무 채널"
                                  SelectionChanged="PreviewSelectionChanged" />
                        <TextBlock x:Name="ChannelSummaryTextBlock" Text="채널을 선택하세요." TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceSummaryTextBlock" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="DocumentSummaryTextBlock" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <DataGrid x:Name="RecipientGrid" Height="150" Margin="0,10,0,0"
                                  ItemsSource="{Binding Recipients}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  AutomationProperties.Name="전달 수신자 미리보기">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="수신자" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="사용자 ID" Binding="{Binding UserId}" Width="150" />
                                <DataGridTextColumn Header="채널 역할" Binding="{Binding MemberRole}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="12" Background="{StaticResource PanelMutedBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="안내 문구와 전달 사유" FontSize="17" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Width="92" Height="30" Content="문구 저장"
                                    AutomationProperties.Name="현재 안내 문구를 현장 템플릿으로 저장"
                                    Click="SaveTemplateButton_Click" />
                            <TextBox x:Name="TemplateNameTextBox" Height="30" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" AutomationProperties.Name="새 문구 템플릿 이름" />
                        </DockPanel>
                        <ComboBox x:Name="TemplateComboBox" Height="32" Margin="0,8,0,0"
                                  ItemsSource="{Binding Templates}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="현장 안내 문구 템플릿"
                                  SelectionChanged="TemplateComboBox_SelectionChanged" />
                        <TextBlock Margin="0,8,0,0" Text="제목" />
                        <TextBox x:Name="DeliveryTitleTextBox" Height="32" Margin="0,4,0,0"
                                 AutomationProperties.Name="전달 제목" />
                        <TextBlock Margin="0,8,0,0" Text="안내 문구" />
                        <TextBox x:Name="DeliveryBodyTextBox" MinHeight="110" MaxHeight="220" Margin="0,4,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="작업순서 변경 안내 문구" />
                        <TextBlock Margin="0,8,0,0" Text="전달 사유" />
                        <TextBox x:Name="DeliveryReasonTextBox" Height="32" Margin="0,4,0,0"
                                 AutomationProperties.Name="작업순서 변경 전달 사유" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ChannelDeliveryButton" Height="36" Content="채널로 전달"
                                    AutomationProperties.Name="미리보기 내용으로 채널 메시지 전달"
                                    Click="ChannelDeliveryButton_Click" />
                            <Button x:Name="HandoverDeliveryButton" Grid.Column="2" Height="36" Content="인수인계 만들기"
                                    AutomationProperties.Name="미리보기 내용으로 인수인계 생성"
                                    Click="HandoverDeliveryButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="4" Padding="12" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Height="32" Margin="0,8,0,0" Content="채널함으로 이동"
                            AutomationProperties.Name="채널함 열기" Click="OpenChannelInboxButton_Click" />
                    <Button Height="32" Margin="0,8,0,0" Content="인수인계 현황으로 이동"
                            AutomationProperties.Name="인수인계 확인 현황 열기" Click="OpenHandoverStatusButton_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="전달 결과" FontSize="17" FontWeight="SemiBold" />
                    <TextBox x:Name="ResultTextBox" Margin="0,8,0,0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="수신자별 전달 결과와 복구 안내"
                             AutomationProperties.HelpText="성공과 실패 수신자, 보존된 원천, 담당자와 재전송 대상을 표시합니다." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
