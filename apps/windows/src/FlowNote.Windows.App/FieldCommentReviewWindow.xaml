<Window x:Class="FlowNote.Windows.App.FieldCommentReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldComment 관리자 검토"
        Width="1420"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="142" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="FieldComment 관리자 작업함"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AIReadinessBoundaryTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="FieldComment 운영 집계를 먼저 불러오고, AI 준비도는 후속 참고 지표로 표시합니다."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Margin="16,0,0,0"
                               Foreground="#8A4B08"
                               Text="검토·분석·선정 운영 우선 · AI 준비도는 후속 참고"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>

                <UniformGrid Grid.Row="1" Columns="6" Margin="0,8,0,0">
                    <Button Margin="0,0,4,0" Tag="UNREVIEWED" Click="DashboardFilterButton_Click">
                        <StackPanel>
                            <TextBlock Text="미검토" HorizontalAlignment="Center" />
                            <TextBlock x:Name="UnreviewedCountTextBlock" Text="-" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0" Tag="CONFLICT" Click="DashboardFilterButton_Click">
                        <StackPanel>
                            <TextBlock Text="상충" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ConflictCountTextBlock" Text="-" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0" Tag="HIGH_RISK" Click="DashboardFilterButton_Click">
                        <StackPanel>
                            <TextBlock Text="안전·품질 위험" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SafetyQualityRiskCountTextBlock" Text="-" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0" Tag="REPORT_UNLINKED" Click="DashboardFilterButton_Click">
                        <StackPanel>
                            <TextBlock Text="보고서 미연결" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ReportUnlinkedCountTextBlock" Text="-" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0,0,0" Tag="UNASSIGNED" Click="DashboardFilterButton_Click">
                        <StackPanel>
                            <TextBlock Text="담당자 없음" HorizontalAlignment="Center" />
                            <TextBlock x:Name="UnassignedCountTextBlock" Text="-" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0,0,0" Tag="OVERDUE" Click="DashboardFilterButton_Click">
                        <StackPanel>
                            <TextBlock Text="기한 초과" HorizontalAlignment="Center" />
                            <TextBlock x:Name="OverdueCountTextBlock" Text="-" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="검토 상태">
                        <TextBlock x:Name="ReviewStatusSummaryTextBlock"
                                   Margin="8"
                                   Text="서버 조회 전"
                                   TextWrapping="Wrap" />
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="후속 AI 활용 참고(운영 처리 기준 아님)">
                        <DataGrid ItemsSource="{Binding ReadinessGaps}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="범주" Binding="{Binding CategoryLabel}" Width="*" />
                                <DataGridTextColumn Header="유형" Binding="{Binding ScenarioLabel}" Width="72" />
                                <DataGridTextColumn Header="현재/필수" Binding="{Binding CoverageText}" Width="76" />
                                <DataGridTextColumn Header="부족" Binding="{Binding Missing}" Width="48" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Column="4" Header="담당자와 다음 조치">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="ReviewActionGrid"
                                      ItemsSource="{Binding ReviewActions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      RowHeight="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="항목" Binding="{Binding TitleWithCount}" Width="145" />
                                    <DataGridTextColumn Header="담당자" Binding="{Binding Owner}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="다음 조치" Binding="{Binding NextAction}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="1"
                                    Width="124"
                                    Height="26"
                                    HorizontalAlignment="Right"
                                    Content="선택 작업함 열기"
                                    Click="OpenSelectedActionButton_Click" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelMutedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="7">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="상태" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="StatusFilterComboBox"
                                  Height="30"
                                  Margin="0,4,0,0"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="문서" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="DocumentFilterTextBox"
                                 Height="30"
                                 Margin="0,4,0,0"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="작성자" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="AuthorFilterTextBox"
                                 Height="30"
                                 Margin="0,4,0,0"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="태그" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="TagFilterTextBox"
                                 Height="30"
                                 Margin="0,4,0,0"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="시작일" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker x:Name="CreatedFromDatePicker"
                                    Height="30"
                                    Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="종료일" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker x:Name="CreatedToDatePicker"
                                    Height="30"
                                    Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="검색" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Height="30"
                                Margin="0,4,0,0"
                                Content="필터 적용"
                                Click="RefreshButton_Click" />
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Grid.Row="1" Columns="9" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="담당자" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="AssignedFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="라인" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="LineFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="설비" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="EquipmentFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="공정" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ProcessFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="오류 유형" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ErrorTypeFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="오래된 NEW" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="AgingFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="첨부" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="AttachmentFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="보고서 연결" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="ReportLinkFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="우선순위/작업함" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="WorkbenchFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Grid.Row="2" Columns="6" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="담당 역할" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="AssignedRoleFilterComboBox" Height="28" Margin="0,3,0,0"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="신호등" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="SignalFilterComboBox" Height="28" Margin="0,3,0,0"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="채널" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ChannelFilterTextBox" Height="28" Margin="0,3,0,0" ToolTip="서버 채널 ID·이름·유형" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="문서 버전" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="DocumentVersionFilterTextBox" Height="28" Margin="0,3,0,0" ToolTip="로컬 문서 버전 번호" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="검토 기한 시작" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker x:Name="ReviewDueFromDatePicker" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="검토 기한 종료" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker x:Name="ReviewDueToDatePicker" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                </UniformGrid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FilterHintTextBlock"
                               Margin="0,0,14,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="저장 보기"
                                   Margin="0,0,8,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SavedViewComboBox"
                                  Width="150"
                                  Height="28"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="SavedViewComboBox_SelectionChanged" />
                        <TextBox x:Name="SavedViewNameTextBox"
                                 Width="130"
                                 Height="28"
                                 Margin="6,0,0,0"
                                 ToolTip="저장할 보기 이름" />
                        <Button Width="78"
                                Height="28"
                                Margin="6,0,0,0"
                                Content="보기 저장"
                                Click="SaveViewButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,8">
                        <TextBlock Text="검토 작업함"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Width="146"
                                Height="28"
                                Content="선택 항목 보고서로"
                                Click="SendSelectedToReportButton_Click" />
                    </DockPanel>
                    <DataGrid x:Name="FieldCommentGrid"
                          ItemsSource="{Binding FieldComments}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          BorderThickness="0"
                          SelectionChanged="FieldCommentGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="94" />
                        <DataGridTextColumn Header="처리 우선 사유" Binding="{Binding PriorityLabel}" Width="142" />
                        <DataGridTextColumn Header="문서" Binding="{Binding DocumentTitle}" Width="*" />
                        <DataGridTextColumn Header="작성자" Binding="{Binding AuthorName}" Width="96" />
                        <DataGridTextColumn Header="태그" Binding="{Binding DocumentTags}" Width="132" />
                        <DataGridTextColumn Header="첨부" Binding="{Binding AttachmentCount}" Width="58" />
                        <DataGridTextColumn Header="등록시간" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="132" />
                    </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="168" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66" />
                            <RowDefinition Height="86" />
                            <RowDefinition Height="86" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="154" />
                            <RowDefinition Height="154" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedTitleTextBlock"
                                       Text="선택된 FieldComment 없음"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="EvidenceTextBlock"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="원천 hash · 첨부 · 문서 버전 · 채널 권한: 서버 조회 전" />
                            <TextBlock x:Name="IndependentReviewGuidanceTextBlock"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#9C2B1B"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="원천 기록(불변)" FontWeight="SemiBold" Foreground="#8A4B08" />
                            <TextBox x:Name="RawContentTextBox"
                                     Height="56"
                                     Margin="0,4,0,0"
                                     IsReadOnly="True"
                                     Background="#FFF8E8"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="관리자 정리 내용(해석)" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="NormalizedContentTextBox"
                                     Height="56"
                                     Margin="0,4,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="관리자 분석 내용(해석)" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="AnalysisContentTextBox"
                                     Margin="0,4,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2">
                                <TextBlock Text="상태 변경 사유(필수 · 감사 이력 저장)" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TransitionReasonTextBox" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="담당자" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="AssignedToTextBox" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="검토 기한" Foreground="{StaticResource SecondaryTextBrush}" />
                                <DatePicker x:Name="ReviewDueDatePicker" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Row="2"
                                      Grid.Column="0"
                                      x:Name="ConflictCheckBox"
                                      Margin="0,9,8,0"
                                      Content="상충 / 검토 필요" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     x:Name="ConflictBasisTextBox"
                                     Height="30"
                                     Margin="0,4,0,0"
                                     ToolTip="상충 판단 근거와 선정/제외 사유를 입력하세요." />
                        </Grid>
                        <UniformGrid Grid.Row="5"
                                     Columns="2"
                                     Rows="4"
                                     Margin="0,8,0,0">
                            <ComboBox x:Name="ReviewStatusComboBox"
                                      Height="30"
                                      Margin="0,0,4,4"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value" />
                            <Button Height="30"
                                    Margin="4,0,0,4"
                                    Content="검토 내용 저장"
                                    Click="SaveReviewButton_Click" />
                            <Button Height="30"
                                    Margin="0,4,4,0"
                                    Content="선택 항목 일괄 저장"
                                    Click="BulkSaveReviewButton_Click" />
                            <Button Height="30"
                                    Margin="4,4,0,0"
                                    Content="원천 연결 확인"
                                    Click="TraceabilityButton_Click" />
                            <Button x:Name="RetryBulkResultButton"
                                    Height="30"
                                    Margin="0,4,4,0"
                                    Content="일괄 결과 다시 확인"
                                    IsEnabled="False"
                                    Click="RetryBulkResultButton_Click" />
                            <Button Height="30"
                                    Margin="4,4,0,0"
                                    Content="품질 이슈 전체"
                                    Click="ShowQualityIssuesButton_Click" />
                            <Button Height="30"
                                    Margin="0,4,4,0"
                                    Content="현재 항목 보고서로"
                                    Click="SendCurrentToReportButton_Click" />
                            <Button Height="30"
                                    Margin="4,4,0,0"
                                    Content="보고서 근거 확인"
                                    Click="TraceabilityButton_Click" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,8">
                            <TextBlock Text="첨부 사진/파일"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <Button DockPanel.Dock="Right"
                                    Width="88"
                                    Height="26"
                                    Content="열기"
                                    Click="OpenAttachmentButton_Click" />
                        </DockPanel>
                        <DataGrid x:Name="AttachmentGrid"
                                  ItemsSource="{Binding Attachments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="파일명" Binding="{Binding OriginalFileName}" Width="*" />
                                <DataGridTextColumn Header="유형" Binding="{Binding AttachmentType}" Width="72" />
                                <DataGridTextColumn Header="크기" Binding="{Binding SizeBytes}" Width="84" />
                                <DataGridTextColumn Header="서버ID" Binding="{Binding ServerAttachmentId}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="StatusTextBlock"
                   Margin="2,8,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</Window>
