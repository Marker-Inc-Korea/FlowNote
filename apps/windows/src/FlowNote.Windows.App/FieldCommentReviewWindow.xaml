<Window x:Class="FlowNote.Windows.App.FieldCommentReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldComment 관리자 검토"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="156" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelMutedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="상태" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="StatusFilterComboBox"
                              Height="30"
                              Margin="0,4,0,0"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="문서" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="DocumentFilterTextBox"
                             Height="30"
                             Margin="0,4,0,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="작성자" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="AuthorFilterTextBox"
                             Height="30"
                             Margin="0,4,0,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="태그" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="TagFilterTextBox"
                             Height="30"
                             Margin="0,4,0,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="시작일" Foreground="{StaticResource SecondaryTextBrush}" />
                    <DatePicker x:Name="CreatedFromDatePicker"
                                Height="30"
                                Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="종료일" Foreground="{StaticResource SecondaryTextBrush}" />
                    <DatePicker x:Name="CreatedToDatePicker"
                                Height="30"
                                Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="6"
                        Height="32"
                        Margin="0,22,10,0"
                        Content="조회"
                        Click="RefreshButton_Click" />
                <StackPanel Grid.Column="7" Margin="0,2,0,0">
                    <TextBlock x:Name="FilterHintTextBlock"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <ComboBox x:Name="SavedViewComboBox" Width="150" Height="28"
                                  DisplayMemberPath="Name" SelectionChanged="SavedViewComboBox_SelectionChanged" />
                        <TextBox x:Name="SavedViewNameTextBox" Width="130" Height="28" Margin="6,0,0,0"
                                 ToolTip="저장할 보기 이름" />
                        <Button Width="72" Height="28" Margin="6,0,0,0" Content="보기 저장" Click="SaveViewButton_Click" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.ColumnSpan="8" Margin="0,64,0,0" VerticalAlignment="Top">
                    <StackPanel Width="116" Margin="0,0,8,0">
                        <TextBlock Text="담당자" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="AssignedFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="106" Margin="0,0,8,0">
                        <TextBlock Text="라인" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="LineFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="106" Margin="0,0,8,0">
                        <TextBlock Text="설비" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="EquipmentFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="106" Margin="0,0,8,0">
                        <TextBlock Text="공정" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ProcessFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="116" Margin="0,0,8,0">
                        <TextBlock Text="오류 유형" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ErrorTypeFilterTextBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,8,0">
                        <TextBlock Text="오래된 NEW" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="AgingFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,8,0">
                        <TextBlock Text="첨부" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="AttachmentFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="112">
                        <TextBlock Text="보고서 연결" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="ReportLinkFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Width="128" Margin="8,0,0,0">
                        <TextBlock Text="우선순위/작업함" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="WorkbenchFilterComboBox" Height="28" Margin="0,3,0,0" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DataGrid x:Name="FieldCommentGrid"
                          ItemsSource="{Binding FieldComments}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          BorderThickness="0"
                          SelectionChanged="FieldCommentGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="94" />
                        <DataGridTextColumn Header="처리 우선 사유" Binding="{Binding PriorityLabel}" Width="142" />
                        <DataGridTextColumn Header="문서" Binding="{Binding DocumentTitle}" Width="*" />
                        <DataGridTextColumn Header="작성자" Binding="{Binding AuthorName}" Width="96" />
                        <DataGridTextColumn Header="태그" Binding="{Binding DocumentTags}" Width="132" />
                        <DataGridTextColumn Header="첨부" Binding="{Binding AttachmentCount}" Width="58" />
                        <DataGridTextColumn Header="등록시간" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="132" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="168" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="86" />
                            <RowDefinition Height="86" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedTitleTextBlock"
                                       Text="선택된 FieldComment 없음"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="EvidenceTextBlock"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="원천 hash · 첨부 · 문서 버전 · 채널 권한: 서버 조회 전" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="원천 기록(불변)" FontWeight="SemiBold" Foreground="#8A4B08" />
                            <TextBox x:Name="RawContentTextBox"
                                     Height="56"
                                     Margin="0,4,0,0"
                                     IsReadOnly="True"
                                     Background="#FFF8E8"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="관리자 정리 내용(해석)" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="NormalizedContentTextBox"
                                     Height="56"
                                     Margin="0,4,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="관리자 분석 내용(해석)" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="AnalysisContentTextBox"
                                     Margin="0,4,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="상태 변경 사유(필수 · 감사 이력 저장)" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TransitionReasonTextBox" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="담당자" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="AssignedToTextBox" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="검토 기한" Foreground="{StaticResource SecondaryTextBrush}" />
                                <DatePicker x:Name="ReviewDueDatePicker" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Row="1"
                                      Grid.Column="0"
                                      x:Name="ConflictCheckBox"
                                      Margin="0,10,8,0"
                                      Content="CONFLICT / 검토 필요 표지" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     x:Name="ConflictBasisTextBox"
                                     Height="30"
                                     Margin="0,4,0,0"
                                     ToolTip="상충 판단 근거와 선정/제외 사유를 입력하세요." />
                        </Grid>
                        <DockPanel Grid.Row="5" Margin="0,10,0,0">
                            <ComboBox x:Name="ReviewStatusComboBox"
                                      Width="150"
                                      Height="30"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      DockPanel.Dock="Left" />
                            <Button Width="116"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Content="검토 저장"
                                    DockPanel.Dock="Left"
                                    Click="SaveReviewButton_Click" />
                            <Button Width="116"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Content="선택 일괄 저장"
                                    DockPanel.Dock="Left"
                                    Click="BulkSaveReviewButton_Click" />
                            <Button Width="116"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Content="서버 역추적"
                                    DockPanel.Dock="Left"
                                    Click="TraceabilityButton_Click" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,8">
                            <TextBlock Text="첨부 사진/파일"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <Button DockPanel.Dock="Right"
                                    Width="88"
                                    Height="26"
                                    Content="열기"
                                    Click="OpenAttachmentButton_Click" />
                        </DockPanel>
                        <DataGrid x:Name="AttachmentGrid"
                                  ItemsSource="{Binding Attachments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="파일명" Binding="{Binding OriginalFileName}" Width="*" />
                                <DataGridTextColumn Header="유형" Binding="{Binding AttachmentType}" Width="72" />
                                <DataGridTextColumn Header="크기" Binding="{Binding SizeBytes}" Width="84" />
                                <DataGridTextColumn Header="서버ID" Binding="{Binding ServerAttachmentId}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="StatusTextBlock"
                   Margin="2,8,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</Window>
