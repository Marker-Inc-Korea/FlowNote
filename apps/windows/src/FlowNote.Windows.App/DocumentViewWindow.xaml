<Window x:Class="FlowNote.Windows.App.DocumentViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="문서 보기"
        Width="760"
        Height="700"
        MinWidth="640"
        MinHeight="580"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Margin="0,0,14,0"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="DownloadCopyButton"
                            Width="104"
                            Height="28"
                            Content="복사본 저장"
                            Click="DownloadCopyButton_Click" />
                    <Button x:Name="ApprovalWorkbenchButton"
                            Width="112"
                            Height="28"
                            Margin="6,0,0,0"
                            Content="검토·승인 이력"
                            Click="ApprovalWorkbenchButton_Click"
                            AutomationProperties.Name="문서 검토 및 공개 승인 이력 열기" />
                </StackPanel>

                <TextBlock x:Name="MetaTextBlock"
                           Grid.Row="1"
                           Margin="0,5,14,0"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Margin="6,5,0,0"
                        Padding="7,2"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <TextBlock x:Name="SecurityPolicyTextBlock"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextAlignment="Right" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="문서 내용"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="ContentTextBox"
                             Margin="0,8,0,14"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="13" />
                    <Border x:Name="PreviewFailurePanel"
                            Visibility="Collapsed"
                            Margin="0,8,0,14"
                            Padding="16"
                            BorderBrush="#C98A00"
                            BorderThickness="1"
                            Background="#FFF8E8"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="문서를 안전하게 미리 볼 수 없습니다"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#6B4500" />
                            <TextBlock x:Name="FailureFileTypeTextBlock"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FailureCategoryTextBlock"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FailureSummaryTextBlock"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FailurePreservationTextBlock"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FailureNextActionTextBlock"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <wv2:WebView2 x:Name="PdfPreview"
                                  Visibility="Collapsed"
                                  Height="520"
                                  Margin="0,8,0,14" />
                    <TabControl x:Name="SpreadsheetPreview"
                                Visibility="Collapsed"
                                Margin="0,8,0,14"
                                MinHeight="360"
                                MaxHeight="520">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding Table.DefaultView}"
                                              AutoGenerateColumns="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="All"
                                              GridLinesVisibility="All"
                                              RowHeight="32"
                                              ColumnHeaderHeight="32" />
                                </Grid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <Image x:Name="ImagePreview"
                           Visibility="Collapsed"
                           Stretch="Uniform"
                           MaxHeight="320"
                           Margin="0,8,0,14" />

                    <Border BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="현장 코멘트 이력"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox x:Name="CombinedCommentTextBox"
                                     Margin="0,8,0,0"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock Text="현장 코멘트"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBox x:Name="CommentTextBox"
                         Grid.Row="1"
                         Margin="0,8,0,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <DockPanel Grid.Row="2"
                           Margin="0,0,0,8">
                    <Button x:Name="SelectAttachmentButton"
                            Width="110"
                            Height="28"
                            DockPanel.Dock="Left"
                            Content="파일 첨부"
                            Click="SelectAttachmentButton_Click" />
                    <Button x:Name="ClearAttachmentButton"
                            Width="80"
                            Height="28"
                            Margin="8,0,0,0"
                            DockPanel.Dock="Left"
                            Content="비우기"
                            Click="ClearAttachmentButton_Click" />
                    <TextBlock x:Name="AttachmentSummaryTextBlock"
                               Margin="10,5,0,0"
                               Text="첨부 없음"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </DockPanel>
                <Button x:Name="SaveCommentButton"
                        Grid.Row="3"
                        Width="120"
                        Height="34"
                        HorizontalAlignment="Right"
                        Content="저장"
                        Click="SaveCommentButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
