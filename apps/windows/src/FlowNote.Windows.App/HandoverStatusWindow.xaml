<Window x:Class="FlowNote.Windows.App.HandoverStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="인수인계 확인 현황"
        Width="1080"
        Height="660"
        MinWidth="920"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <StackPanel>
                <TextBlock Text="인수인계 확인 현황"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Height="42"
                            Padding="12,0"
                            Background="{StaticResource PanelMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="인수인계 목록"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Border>
                    <DataGrid x:Name="HandoverGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionChanged="HandoverGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="96" />
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="170" />
                            <DataGridTextColumn Header="발송" Binding="{Binding SentAt, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
                            <DataGridTextColumn Header="원천" Binding="{Binding SourceLinkText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Height="42"
                            Padding="12,0"
                            Background="{StaticResource PanelMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="수신자별 확인 상태"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Border>
                    <DataGrid x:Name="ReceiptGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="수신자" Binding="{Binding RecipientId}" Width="160" />
                            <DataGridTextColumn Header="상태" Binding="{Binding ReceiptStatusLabel}" Width="110" />
                            <DataGridTextColumn Header="읽음" Binding="{Binding ReadAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                            <DataGridTextColumn Header="확인" Binding="{Binding AcknowledgedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                            <DataGridTextColumn Header="후속 필요" Binding="{Binding FollowUpRequiredAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                            <DataGridTextColumn Header="메모" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="158" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReceiptNoteTextBox"
                         Height="78"
                         Margin="0,0,10,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="상태 변경 메모 또는 후속 FieldComment 내용" />
                <Button Grid.Column="1"
                        Height="34"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Content="읽음"
                        Click="ReadButton_Click" />
                <Button Grid.Column="2"
                        Height="34"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Content="확인"
                        Click="AckButton_Click" />
                <Button Grid.Column="3"
                        Height="34"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Content="보류"
                        Click="HoldButton_Click" />
                <Button Grid.Column="4"
                        Height="34"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Content="후속 필요"
                        Click="FollowUpRequiredButton_Click" />
                <Button Grid.Column="5"
                        Height="34"
                        VerticalAlignment="Top"
                        Content="후속 코멘트 저장"
                        ToolTip="선택한 인수인계를 원천으로 보존하는 현장 코멘트를 저장합니다."
                        Click="FollowUpFieldCommentButton_Click" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Width="96"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="새로고침"
                    Click="RefreshButton_Click" />
            <Button Width="84"
                    Height="34"
                    Content="닫기"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
