<Window x:Class="FlowNote.Windows.App.AIFieldReadinessSampleReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="AI 실제 익명 현장 독립 표본 검토" Width="1460" Height="880"
        MinWidth="1180" MinHeight="720" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <x:Array x:Key="PassFailOptions" Type="{x:Type sys:String}">
            <sys:String>PASS</sys:String>
            <sys:String>FAIL</sys:String>
        </x:Array>
        <x:Array x:Key="ConflictOptions" Type="{x:Type sys:String}">
            <sys:String>PASS</sys:String>
            <sys:String>FAIL</sys:String>
            <sys:String>NOT_APPLICABLE</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Padding="12" Background="{StaticResource PanelMutedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="24칸 실제 익명 현장 독립 표본 검토" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PlanTextBlock" Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Width="92" Height="32" Content="새로 고침"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ReviewStateTextBlock" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="BlindNoticeTextBlock" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ReviewGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      CanUserAddRows="False" SelectionChanged="ReviewGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="범주" Binding="{Binding CategoryLabel}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="유형" Binding="{Binding ScenarioLabel}" Width="72" IsReadOnly="True"/>
                    <DataGridTextColumn Header="case key" Binding="{Binding CaseKey}" Width="180" IsReadOnly="True"/>
                    <DataGridComboBoxColumn Header="trace" Width="78"
                                            ItemsSource="{StaticResource PassFailOptions}"
                                            SelectedItemBinding="{Binding CitationTrace, Mode=TwoWay}"/>
                    <DataGridComboBoxColumn Header="의미" Width="78"
                                            ItemsSource="{StaticResource PassFailOptions}"
                                            SelectedItemBinding="{Binding CitationMeaning, Mode=TwoWay}"/>
                    <DataGridComboBoxColumn Header="상충 표시" Width="112"
                                            ItemsSource="{StaticResource ConflictOptions}"
                                            SelectedItemBinding="{Binding ConflictDisclosure, Mode=TwoWay}"/>
                    <DataGridComboBoxColumn Header="권한 경계" Width="96"
                                            ItemsSource="{StaticResource PassFailOptions}"
                                            SelectedItemBinding="{Binding PermissionBoundary, Mode=TwoWay}"/>
                    <DataGridTextColumn Header="판정 메모" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" MinWidth="180"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <TextBlock Text="고정 근거 trace" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" x:Name="TraceTextBox" Margin="0,6,0,0" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBox Grid.Row="2" x:Name="ComparisonTextBox" Margin="0,8,0,0" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="두 독립 판정이 모두 제출된 뒤에만 판정 비교를 표시합니다."/>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90" Height="32" Margin="0,0,8,0" Content="닫기" Click="CloseButton_Click"/>
                <Button x:Name="SubmitButton" Width="142" Height="32" Content="독립 판정 제출"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
