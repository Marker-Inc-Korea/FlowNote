<Window x:Class="FlowNote.Windows.App.AISearchQualityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 근거 후보 운영 점검"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="176" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelMutedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AI 검색 품질 점검"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="외부 AI 호출 없이 서버 DB에서 재생성한 근거 후보와 제외 사유를 확인합니다."
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBox x:Name="SourceIdFilterTextBox"
                             Width="240"
                             Height="32"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="source_id로 후보를 좁혀 조회" />
                    <ComboBox x:Name="SourceTypeFilterComboBox"
                              Width="190"
                              Height="32"
                              Margin="0,0,8,0"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value" />
                    <Button Width="86"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="조회"
                            Click="RefreshButton_Click" />
                    <Button Width="118"
                            Height="32"
                            Content="후보 재생성"
                            Click="RebuildButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="10,8"
                               Text="원천별 후보 수"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <DataGrid ItemsSource="{Binding SourceCounts}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="원천" Binding="{Binding SourceTypeLabel}" Width="*" />
                            <DataGridTextColumn Header="후보" Binding="{Binding Count}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="FieldComment 검토 준비도"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="ReadinessSummaryTextBlock"
                               Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ReadinessWarningTextBlock"
                               Margin="0,8,0,0"
                               Foreground="#B45309"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ScopeReadinessTextBlock"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <DataGrid x:Name="ReadinessStatusGrid"
                              Height="82"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding StatusCounts}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="*" />
                            <DataGridTextColumn Header="건수" Binding="{Binding Count}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="10,8"
                               Text="제외 사유별 운영 조치"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <DataGrid x:Name="ExcludedReasonGrid"
                              ItemsSource="{Binding ExcludedReasons}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="사유" Binding="{Binding Label}" Width="170" />
                            <DataGridTextColumn Header="건수" Binding="{Binding Count}" Width="54" />
                            <DataGridTextColumn Header="운영 조치" Binding="{Binding OperatorAction}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="10,8"
                           Text="근거 후보 목록"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <DataGrid x:Name="CandidateGrid"
                          ItemsSource="{Binding Candidates}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          BorderThickness="0"
                          SelectionChanged="CandidateGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="원천" Binding="{Binding SourceTypeLabel}" Width="154" />
                        <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="상태" Binding="{Binding ReviewStatusLabel}" Width="92" />
                        <DataGridTextColumn Header="trace_table" Binding="{Binding TraceTable}" Width="176" />
                        <DataGridTextColumn Header="trace_id" Binding="{Binding TraceId}" Width="220" />
                        <DataGridTextColumn Header="trace_version_id" Binding="{Binding TraceVersionId}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Background="{StaticResource PanelMutedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TraceTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <Button Grid.Column="1"
                        Width="96"
                        Height="30"
                        Margin="10,0,0,0"
                        Content="추적값 복사"
                        VerticalAlignment="Top"
                        Click="CopyTraceButton_Click" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="StatusTextBlock"
                   Margin="2,8,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</Window>
