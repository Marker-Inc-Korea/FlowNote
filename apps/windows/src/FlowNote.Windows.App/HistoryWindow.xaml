<Window x:Class="FlowNote.Windows.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이력"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <StackPanel>
                <TextBlock Text="이력"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="SummaryTextBlock"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="활동 이력">
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DataGrid x:Name="HistoryGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeight="42"
                              ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                            <DataGridTextColumn Header="사용자" Binding="{Binding ActorName}" Width="120" />
                            <DataGridTextColumn Header="유형" Binding="{Binding EventType}" Width="160" />
                            <DataGridTextColumn Header="대상" Binding="{Binding TargetTitle}" Width="180" />
                            <DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="동기화 큐">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SyncQueueSummaryTextBlock"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBox x:Name="ConflictReasonTextBox"
                                         Width="220"
                                         Height="32"
                                         Margin="0,0,8,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="충돌 해결 또는 폐기 사유" />
                                <Button Width="154"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Content="새 revision으로 재요청"
                                        Click="RetryConflictButton_Click" />
                                <Button Width="170"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Content="로컬 태그 delta만 재적용"
                                        Click="ReapplyTagDeltaButton_Click" />
                                <Button Width="138"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Content="새 버전으로 등록"
                                        Click="NewVersionConflictButton_Click" />
                                <Button Width="126"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Content="서버본 유지·폐기"
                                        Click="DiscardConflictButton_Click" />
                                <Button Width="96"
                                        Height="32"
                                        Content="일반 재시도"
                                        Click="RetrySyncButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DataGrid x:Name="SyncQueueGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  RowHeight="48"
                                  ColumnHeaderHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="78" />
                                <DataGridTextColumn Header="충돌 코드" Binding="{Binding ConflictCode}" Width="170" />
                                <DataGridTextColumn Header="판정" Binding="{Binding ConflictState}" Width="150" />
                                <DataGridTextColumn Header="우선순위" Binding="{Binding PriorityText}" Width="104" />
                                <DataGridTextColumn Header="운영 상태" Binding="{Binding OperationalState}" Width="118" />
                                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="150" />
                                <DataGridTextColumn Header="대상" Binding="{Binding EntityText}" Width="142" />
                                <DataGridTextColumn Header="작업" Binding="{Binding ActionText}" Width="150" />
                                <DataGridTextColumn Header="시도" Binding="{Binding AttemptCount}" Width="60" />
                                <DataGridTextColumn Header="마지막 시도" Binding="{Binding LastAttemptAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                                <DataGridTextColumn Header="조치" Binding="{Binding OperatorAction}" Width="260" />
                                <DataGridTextColumn Header="실패 사유" Binding="{Binding LastError}" Width="360" />
                                <DataGridTextColumn Header="서버 값" Binding="{Binding ServerValue}" Width="280" />
                                <DataGridTextColumn Header="보존된 로컬 요청" Binding="{Binding LocalRequest}" Width="300" />
                                <DataGridTextColumn Header="기준/현재 revision" Binding="{Binding RevisionComparison}" Width="150" />
                                <DataGridTextColumn Header="원본 보존 위치" Binding="{Binding SourcePreservedPath}" Width="260" />
                                <DataGridTextColumn Header="허용 행동" Binding="{Binding AllowedActions}" Width="250" />
                                <DataGridTextColumn Header="서버 read-back" Binding="{Binding ServerReadBack}" Width="300" />
                                <DataGridTextColumn Header="자동 병합 가능" Binding="{Binding AutoMerge}" Width="240" />
                                <DataGridTextColumn Header="사용자 선택 필요" Binding="{Binding UserChoice}" Width="280" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="서버 재결합">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12">
                        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ReconciliationSummaryTextBlock"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="10"
                                            Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="먼저 확인 · 변경·보존·충돌 영향"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock x:Name="ReconciliationImpactSummaryTextBlock"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="10"
                                            Background="#FFF7ED" BorderBrush="#C2410C"
                                            BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="승인 후 필수 · 서버 재시작 절차"
                                                       FontWeight="SemiBold" Foreground="#9A3412" />
                                            <TextBlock x:Name="RecoveryRestartConditionsTextBlock"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="#7C2D12" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="10" Background="{StaticResource PanelMutedBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="1. 서버 원판정 · 관측 결과(아직 변경 없음)"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock x:Name="RecoveryVerdictGuideTextBlock"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="10"
                                            Background="{StaticResource PanelMutedBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="2. 적용 조치 · 승인 뒤 로컬 상태 변경"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock x:Name="RecoveryActionGuideTextBlock"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Expander Margin="0,10,0,0" Header="연결·차단·증거 상세 보기">
                                    <Border Margin="0,6,0,0" Padding="10"
                                            Background="{StaticResource WindowBackgroundBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="연결 상태" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryConnectionStatusTextBlock"
                                                           Margin="0,2,0,8" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="안전 수렴 상태" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryConvergenceStatusTextBlock"
                                                           Margin="0,2,0,8" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="차단 원인" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryBlockCauseTextBlock"
                                                           Margin="0,2,0,8" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="다음 단계" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryNextStepTextBlock"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="보존된 원천" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryPreservedSourcesTextBlock"
                                                           Margin="0,2,0,8" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="승인 전 금지 행동" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryProhibitedActionsTextBlock"
                                                           Margin="0,2,0,8" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="담당자와 증거 연결" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecoveryOwnerTextBlock"
                                                           Margin="0,2,0,2" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="RecoveryEvidenceBindingTextBlock"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <Border Margin="0,10,0,0" Padding="10"
                                        Background="{StaticResource PanelMutedBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="일반 운영 동작 · 재결합 위험 승인과 분리되어 있습니다."
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Width="116" Height="32" Margin="0,0,8,0"
                                                    Content="판정 실행"
                                                    Click="CreateReconciliationButton_Click" />
                                            <Button Width="128" Height="32"
                                                    Content="업무 재개 확인"
                                                    Click="ResumeOperationButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="10"
                                        Background="#FFF7ED" BorderBrush="#C2410C"
                                        BorderThickness="2" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="위험 조치 · 재결합 승인 적용"
                                                   FontWeight="SemiBold" Foreground="#9A3412" />
                                        <TextBlock Grid.Row="1" Margin="0,4,0,8" TextWrapping="Wrap"
                                                   Foreground="#7C2D12"
                                                   Text="승인 적용과 감사 이력은 이 화면에서 되돌릴 수 없습니다. 원천은 보존되지만 매핑·큐 상태를 다시 바꾸려면 별도 운영 절차와 새 run이 필요합니다." />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="관리자 승인 사유(필수)" Foreground="#7C2D12" />
                                                <TextBox x:Name="ReconciliationReasonTextBox"
                                                         Height="32" Margin="0,4,0,0"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="관리자 승인 사유" />
                                            </StackPanel>
                                            <CheckBox x:Name="ReconciliationRiskAcknowledgementCheckBox"
                                                      Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock TextWrapping="Wrap" Foreground="#7C2D12"
                                                           Text="위 영향 건수, 원천 보존 범위, 되돌릴 수 없는 승인·감사 기록과 서버 재시작 절차를 다시 읽었습니다." />
                                            </CheckBox>
                                            <Button x:Name="ApplyReconciliationButton" Grid.Column="4"
                                                    Height="36" VerticalAlignment="Center"
                                                    Content="위험 조치: 승인 적용"
                                                    Background="#C2410C" Foreground="White"
                                                    BorderBrush="#9A3412" IsEnabled="False"
                                                    Click="ApplyReconciliationButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <DataGrid x:Name="ReconciliationGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" RowHeight="46" ColumnHeaderHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="run ID" Binding="{Binding RunId}" Width="180" />
                                <DataGridTextColumn Header="1. 서버 원판정(변경 없음)" Binding="{Binding VerdictText}" Width="250" />
                                <DataGridTextColumn Header="2. 적용 조치(승인 시)" Binding="{Binding ActionText}" Width="250" />
                                <DataGridTextColumn Header="대상" Binding="{Binding TargetText}" Width="220" />
                                <DataGridTextColumn Header="적용 시 데이터 영향" Binding="{Binding DataEffect}" Width="360" />
                                <DataGridTextColumn Header="로컬 SHA-256" Binding="{Binding LocalHashSha256}" Width="220" />
                                <DataGridTextColumn Header="서버 SHA-256" Binding="{Binding ServerHashSha256}" Width="220" />
                                <DataGridTextColumn Header="서버 문서 ID" Binding="{Binding ServerDocumentId}" Width="180" />
                                <DataGridTextColumn Header="서버 버전 ID" Binding="{Binding ServerVersionId}" Width="180" />
                                <DataGridTextColumn Header="상세" Binding="{Binding Details}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Width="84"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="새로고침"
                    Click="RefreshButton_Click" />
            <Button Width="84"
                    Height="34"
                    Content="닫기"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
