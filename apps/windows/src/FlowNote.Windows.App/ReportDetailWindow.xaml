<Window x:Class="FlowNote.Windows.App.ReportDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보고서 상세와 원천 역추적"
        Width="1180"
        Height="780"
        MinWidth="940"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="상태 " FontWeight="SemiBold" />
                    <Run x:Name="LifecycleStatusRun" Text="{Binding Status}" />
                    <Run Text="  ·  report revision " FontWeight="SemiBold" />
                    <Run Text="{Binding ReportRevision}" />
                    <Run Text="  ·  생성 문서 " FontWeight="SemiBold" />
                    <Run Text="{Binding GeneratedDocumentId, TargetNullValue=없음}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="내용 hash " FontWeight="SemiBold" />
                    <Run Text="{Binding ContentHashSha256}" />
                </TextBlock>
                <TextBlock x:Name="CorrectionInfoTextBlock" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="#8A4B08" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="source 집합 hash " FontWeight="SemiBold" />
                    <Run Text="{Binding SourceSetHashSha256}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="SourceGrid"
                  Margin="0,10,0,10"
                  ItemsSource="{Binding Sources}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="유형" Binding="{Binding SourceType}" Width="150" />
                <DataGridTextColumn Header="원천 ID" Binding="{Binding SourceId}" Width="210" />
                <DataGridTextColumn Header="당시 version" Binding="{Binding SourceVersionId}" Width="190" />
                <DataGridTextColumn Header="당시 revision" Binding="{Binding SourceRevision}" Width="100" />
                <DataGridTextColumn Header="trace ID" Binding="{Binding TraceId}" Width="190" />
                <DataGridTextColumn Header="당시 hash" Binding="{Binding SourceHashSha256}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Margin="0,0,0,10" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="10,8" FontWeight="SemiBold" Text="보고서 계보 · 현재 유효본과 과거 생성 문서" />
                <DataGrid x:Name="LineageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="110" />
                        <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="정정 사유" Binding="{Binding CorrectionReason}" Width="220" />
                        <DataGridTextColumn Header="생성 문서" Binding="{Binding GeneratedDocumentId}" Width="190" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="원천을 선택하면 당시 version/revision/hash로 확인할 수 있습니다." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CreateCorrectionButton" Width="112" Height="30" Margin="0,0,8,0"
                        Content="정정본 만들기" Click="CreateCorrectionButton_Click" />
                <Button Width="132" Height="30" Margin="0,0,8,0"
                        Content="선택 원천 돌아가기"
                        Click="OpenSourceButton_Click" />
                <Button Width="92" Height="30" Margin="0,0,8,0"
                        Content="보고서 보관"
                        Click="ArchiveButton_Click" />
                <Button Width="80" Height="30" Content="닫기" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
