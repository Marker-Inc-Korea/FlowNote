<Window x:Class="FlowNote.Windows.App.ReportDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보고서 상세와 원천 역추적"
        Width="1180"
        Height="720"
        MinWidth="940"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="상태 " FontWeight="SemiBold" />
                    <Run Text="{Binding Status}" />
                    <Run Text="  ·  report revision " FontWeight="SemiBold" />
                    <Run Text="{Binding ReportRevision}" />
                    <Run Text="  ·  생성 문서 " FontWeight="SemiBold" />
                    <Run Text="{Binding GeneratedDocumentId, TargetNullValue=없음}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="내용 hash " FontWeight="SemiBold" />
                    <Run Text="{Binding ContentHashSha256}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="source 집합 hash " FontWeight="SemiBold" />
                    <Run Text="{Binding SourceSetHashSha256}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="SourceGrid"
                  Margin="0,10,0,10"
                  ItemsSource="{Binding Sources}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="유형" Binding="{Binding SourceType}" Width="150" />
                <DataGridTextColumn Header="원천 ID" Binding="{Binding SourceId}" Width="210" />
                <DataGridTextColumn Header="당시 version" Binding="{Binding SourceVersionId}" Width="190" />
                <DataGridTextColumn Header="당시 revision" Binding="{Binding SourceRevision}" Width="100" />
                <DataGridTextColumn Header="trace ID" Binding="{Binding TraceId}" Width="190" />
                <DataGridTextColumn Header="당시 hash" Binding="{Binding SourceHashSha256}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="원천을 선택하면 당시 version/revision/hash로 확인할 수 있습니다." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="132" Height="30" Margin="0,0,8,0"
                        Content="선택 원천 돌아가기"
                        Click="OpenSourceButton_Click" />
                <Button Width="92" Height="30" Margin="0,0,8,0"
                        Content="보고서 보관"
                        Click="ArchiveButton_Click" />
                <Button Width="80" Height="30" Content="닫기" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
