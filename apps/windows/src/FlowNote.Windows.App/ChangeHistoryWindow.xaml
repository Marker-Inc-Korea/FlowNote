<Window x:Class="FlowNote.Windows.App.ChangeHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="변경 이력"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="변경 이력과 조치 필요 항목"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Margin="0,5,0,0"
                           Text="문서·FieldComment·보고서·작업순서와 동기화 변경을 공통 감사 원천에서 조회합니다. 조치 필요 항목이 먼저 표시됩니다."
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Width="100"
                    Height="34"
                    Content="새로고침"
                    Click="RefreshButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="145" Margin="0,0,8,8">
                        <TextBlock Text="시작일" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker x:Name="FromDatePicker" Height="30" />
                    </StackPanel>
                    <StackPanel Width="145" Margin="0,0,8,8">
                        <TextBlock Text="종료일" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker x:Name="ToDatePicker" Height="30" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,8,8">
                        <TextBlock Text="사용자 ID" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ActorIdTextBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,8,8">
                        <TextBlock Text="사용자 역할" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="ActorRoleComboBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,8,8">
                        <TextBlock Text="장비 ID" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="DeviceIdTextBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,8,8">
                        <TextBlock Text="업무 대상 유형" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="TargetTypeComboBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,8,8">
                        <TextBlock Text="대상 ID·제목" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="TargetQueryTextBox" Height="30" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Width="180" Margin="0,0,8,0">
                        <TextBlock Text="문서 version ID" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="VersionIdTextBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="105" Margin="0,0,8,0">
                        <TextBlock Text="revision" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="RevisionTextBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="135" Margin="0,0,8,0">
                        <TextBlock Text="결과" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="ResultComboBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="135" Margin="0,0,8,0">
                        <TextBlock Text="위험도" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="RiskComboBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,8,0">
                        <TextBlock Text="run ID" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="RunIdTextBox" Height="30" />
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,8,0">
                        <TextBlock Text="correlation ID" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="CorrelationIdTextBox" Height="30" />
                    </StackPanel>
                    <CheckBox x:Name="ActionRequiredCheckBox"
                              Margin="4,17,12,0"
                              VerticalAlignment="Center"
                              Content="조치 필요만" />
                    <Button Width="90"
                            Height="30"
                            Margin="0,16,6,0"
                            Content="필터 적용"
                            Click="ApplyFilterButton_Click" />
                    <Button Width="90"
                            Height="30"
                            Margin="0,16,0,0"
                            Content="초기화"
                            Click="ResetFilterButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,10"
                Padding="12,9"
                Background="#FFF7ED"
                BorderBrush="#FDBA74"
                BorderThickness="1"
                CornerRadius="5">
            <TextBlock x:Name="SummaryTextBlock"
                       FontWeight="SemiBold"
                       Foreground="#9A3412"
                       Text="변경 이력을 조회하는 중입니다." />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="HistoryDataGrid"
                      Grid.Column="0"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionChanged="HistoryDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="조치" Binding="{Binding ActionRequiredLabel}" Width="80" />
                    <DataGridTextColumn Header="위험" Binding="{Binding RiskLabel}" Width="65" />
                    <DataGridTextColumn Header="시각" Binding="{Binding OccurredAtLabel}" Width="140" />
                    <DataGridTextColumn Header="변경" Binding="{Binding EventType}" Width="175" />
                    <DataGridTextColumn Header="업무 대상" Binding="{Binding TargetTitle}" Width="180" />
                    <DataGridTextColumn Header="revision" Binding="{Binding TargetRevisionLabel}" Width="70" />
                    <DataGridTextColumn Header="결과" Binding="{Binding ResultLabel}" Width="85" />
                    <DataGridTextColumn Header="영향" Binding="{Binding Impact}" Width="2*" />
                    <DataGridTextColumn Header="현재 상태" Binding="{Binding CurrentStatus}" Width="95" />
                    <DataGridTextColumn Header="담당자" Binding="{Binding Assignee}" Width="110" />
                    <DataGridTextColumn Header="다음 행동" Binding="{Binding NextAction}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="원본 감사와 업무 역추적"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailSummaryTextBlock"
                               Grid.Row="1"
                               Margin="0,10,0,10"
                               Text="목록에서 항목을 선택하세요."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="AuditDetailTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal">
                        <Button x:Name="OpenActionButton"
                                Width="130"
                                Height="34"
                                IsEnabled="False"
                                Content="조치 화면 열기"
                                Click="OpenActionButton_Click" />
                        <Button Width="130"
                                Height="34"
                                Margin="8,0,0,0"
                                Content="원본 다시 조회"
                                Click="ReloadDetailButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="공통 감사가 권위 원천이며 이 조회 모델은 저장하지 않고 다시 만들 수 있습니다." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PreviousPageButton"
                        Width="90"
                        Height="32"
                        IsEnabled="False"
                        Content="이전"
                        Click="PreviousPageButton_Click" />
                <Button x:Name="NextPageButton"
                        Width="90"
                        Height="32"
                        Margin="6,0,0,0"
                        IsEnabled="False"
                        Content="다음"
                        Click="NextPageButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
