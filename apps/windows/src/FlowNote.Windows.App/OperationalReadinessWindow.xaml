<Window x:Class="FlowNote.Windows.App.OperationalReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="운영 준비도"
        Width="1380"
        Height="860"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="운영 준비도" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="현재 권위 상태와 변경 이력을 함께 확인합니다. 이 화면에서는 업무 데이터를 수정하지 않습니다."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Width="110"
                    Height="36"
                    AutomationProperties.Name="운영 준비도 새로고침"
                    Content="새로고침"
                    Click="RefreshButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="영역" />
                    <ComboBox x:Name="AreaComboBox"
                              Width="210"
                              Height="34"
                              Margin="0,0,16,0"
                              AutomationProperties.Name="준비도 영역 필터" />
                    <TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="상태" />
                    <ComboBox x:Name="SeverityComboBox"
                              Width="130"
                              Height="34"
                              Margin="0,0,16,0"
                              AutomationProperties.Name="준비도 상태 필터" />
                    <TextBlock Margin="0,8,8,0" VerticalAlignment="Center" Text="차단 코드" />
                    <TextBox x:Name="BlockerCodeTextBox"
                             Width="260"
                             Height="34"
                             Margin="0,0,8,0"
                             AutomationProperties.Name="차단 코드 필터" />
                    <Button Width="90" Height="34" Content="적용" Click="ApplyFilterButton_Click" />
                    <Button Width="90" Height="34" Margin="6,0,0,0" Content="초기화" Click="ResetFilterButton_Click" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="SummaryTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SnapshotTextBlock"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="AreaDataGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      AutomationProperties.Name="영역별 운영 준비도 표">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="영역" Binding="{Binding AreaName}" Width="*" />
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="110" />
                    <DataGridTextColumn Header="정상" Binding="{Binding NormalCount}" Width="70" />
                    <DataGridTextColumn Header="주의" Binding="{Binding WarningCount}" Width="70" />
                    <DataGridTextColumn Header="차단" Binding="{Binding BlockedCount}" Width="70" />
                    <DataGridTextColumn Header="집계 오류·권한 안내" Binding="{Binding FailureDisplay}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="AI 실제 현장 준비도" />
                    <TextBlock x:Name="AIStatusTextBlock" Margin="0,8,0,0" FontWeight="SemiBold" />
                    <TextBlock x:Name="AICountTextBlock" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="AISeparationTextBlock"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ActionDataGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      SelectionChanged="ActionDataGrid_SelectionChanged"
                      AutomationProperties.Name="운영 준비도 조치 항목 표">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="상태" Binding="{Binding SeverityDisplay}" Width="90" />
                    <DataGridTextColumn Header="영역" Binding="{Binding AreaName}" Width="130" />
                    <DataGridTextColumn Header="대상" Binding="{Binding TargetTitle}" Width="2*" />
                    <DataGridTextColumn Header="현재 상태" Binding="{Binding CurrentStatus}" Width="110" />
                    <DataGridTextColumn Header="담당 역할" Binding="{Binding ResponsibleRole}" Width="150" />
                    <DataGridTextColumn Header="가장 오래된 항목" Binding="{Binding OldestAtLabel}" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailTitleTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="조치 항목을 선택하세요."
                               TextWrapping="Wrap" />
                    <TextBox x:Name="DetailTextBox"
                             Grid.Row="1"
                             Margin="0,10,0,10"
                             Padding="10"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="선택한 준비도 조치 상세" />
                    <Button x:Name="OpenActionButton"
                            Grid.Row="2"
                            Height="36"
                            IsEnabled="False"
                            Content="기존 업무 화면 열기"
                            AutomationProperties.Name="선택 항목의 기존 업무 화면 열기"
                            Click="OpenActionButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="PreviousPageButton"
                        Width="90" Height="32" IsEnabled="False"
                        Content="이전" Click="PreviousPageButton_Click" />
                <Button x:Name="NextPageButton"
                        Width="90" Height="32" Margin="6,0,0,0" IsEnabled="False"
                        Content="다음" Click="NextPageButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
