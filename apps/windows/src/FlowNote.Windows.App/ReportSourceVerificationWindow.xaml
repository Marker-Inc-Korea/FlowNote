<Window x:Class="FlowNote.Windows.App.ReportSourceVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보고서 고정 근거 확인"
        Width="1080"
        Height="520"
        MinWidth="820"
        MinHeight="380"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryTextBlock"
                   Margin="0,0,0,10"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}" />
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="유형" Binding="{Binding SourceType}" Width="130" />
                <DataGridTextColumn Header="원천 ID" Binding="{Binding SourceId}" Width="220" />
                <DataGridTextColumn Header="고정 version" Binding="{Binding SourceVersionId}" Width="220" />
                <DataGridTextColumn Header="revision" Binding="{Binding SourceRevision}" Width="80" />
                <DataGridTextColumn Header="hash" Binding="{Binding HashLabel}" Width="150" />
                <DataGridCheckBoxColumn Header="적격" Binding="{Binding Valid}" Width="60" />
                <DataGridTextColumn Header="검증 결과" Binding="{Binding Result}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2"
                Width="100"
                Height="32"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Content="닫기"
                IsCancel="True" />
    </Grid>
</Window>
