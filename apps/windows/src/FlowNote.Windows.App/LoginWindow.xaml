<Window x:Class="FlowNote.Windows.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowNote 로그인"
        Width="560"
        Height="720"
        MinWidth="420"
        MinHeight="560"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        KeyboardNavigation.TabNavigation="Continue">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <Border Margin="24"
                Padding="24"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="FlowNote"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Margin="0,6,0,22"
                           Text="현장 문서 관리 클라이언트"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <TextBlock Text="아이디" FontWeight="SemiBold" />
                <TextBox x:Name="LoginIdTextBox"
                         Height="34"
                         Margin="0,4,0,12"
                         Text="admin"
                         AutomationProperties.Name="로그인 아이디"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="비밀번호" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox"
                             Height="34"
                             Margin="0,4,0,12"
                             AutomationProperties.Name="비밀번호"
                             VerticalContentAlignment="Center" />

                <TextBlock x:Name="ServerTargetTextBlock"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="서버 로그인 대상"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <Border x:Name="RecoveryPanel"
                        Margin="0,0,0,12"
                        Padding="12"
                        Visibility="Collapsed"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="업무 재개 전 확인"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"
                                   Foreground="#9A3412" />
                        <TextBox x:Name="RecoveryGuidanceTextBox"
                                 MinHeight="180"
                                 MaxHeight="300"
                                 Padding="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="실패 내용과 복구 안내"
                                 AutomationProperties.HelpText="실패 내용, 보존된 로컬 원천과 큐와 커서, 처리 담당자, 가능한 다음 행동을 표시합니다."
                                 Background="White"
                                 Foreground="#7C2D12" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RetryButton"
                                    MinWidth="130"
                                    MinHeight="36"
                                    Margin="0,0,8,8"
                                    Content="다시 시도(_R)"
                                    AutomationProperties.Name="다시 시도"
                                    Click="RetryButton_Click" />
                            <Button MinWidth="130"
                                    MinHeight="36"
                                    Margin="0,0,0,8"
                                    Content="앱 종료(_X)"
                                    AutomationProperties.Name="앱 종료"
                                    Click="CloseButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="SignInButton"
                        MinHeight="36"
                        Content="로그인(_L)"
                        AutomationProperties.Name="로그인"
                        IsDefault="True"
                        Click="SignInButton_Click" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
