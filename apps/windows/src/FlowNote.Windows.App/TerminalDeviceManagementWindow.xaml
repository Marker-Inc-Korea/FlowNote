<Window x:Class="FlowNote.Windows.App.TerminalDeviceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="승인 단말 관리"
        Width="1180"
        Height="700"
        MinWidth="960"
        MinHeight="620"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Height="50"
                        Padding="14,0"
                        Background="{StaticResource PanelMutedBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="서버 승인 단말 목록"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Width="88"
                                Height="30"
                                Content="새로고침"
                                Click="RefreshButton_Click" />
                        <Button DockPanel.Dock="Right"
                                Width="92"
                                Height="30"
                                Margin="0,0,8,0"
                                Content="신규 등록"
                                Click="NewButton_Click" />
                    </DockPanel>
                </Border>
                <DataGrid x:Name="DeviceGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="38"
                          ColumnHeaderHeight="34"
                          SelectionChanged="DeviceGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="단말명" Binding="{Binding DeviceName}" Width="*" />
                        <DataGridTextColumn Header="device_id" Binding="{Binding DeviceId}" Width="190" />
                        <DataGridTextColumn Header="위치" Binding="{Binding LocationCode}" Width="100" />
                        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="75" />
                        <DataGridTextColumn Header="마지막 접속" Binding="{Binding LastSeenLabel}" Width="145" />
                        <DataGridTextColumn Header="등록자" Binding="{Binding RegisteredBy}" Width="120" />
                        <DataGridTextColumn Header="변경자" Binding="{Binding UpdatedBy}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button x:Name="SaveButton"
                            Height="34"
                            Content="등록"
                            Click="SaveButton_Click" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="32"
                                Content="상태 적용"
                                Click="ApplyStatusButton_Click" />
                        <Button Grid.Column="2"
                                Height="32"
                                Content="교체 단말 준비"
                                Click="PrepareReplacementButton_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="FormTitleTextBlock"
                               Text="신규 승인 단말"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Android 앱이 보내는 device_id를 정확히 입력하세요. 교체 등록 시 선택한 기존 단말은 폐기 상태가 됩니다."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="device_id" Margin="0,14,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="DeviceIdTextBox" Height="30" VerticalContentAlignment="Center" />
                    <TextBlock Text="단말명" Margin="0,10,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="DeviceNameTextBox" Height="30" VerticalContentAlignment="Center" />
                    <TextBlock Text="위치" Margin="0,10,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="LocationCodeTextBox" Height="30" VerticalContentAlignment="Center" />
                    <TextBlock Text="그룹" Margin="0,10,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="GroupIdTextBox" Height="30" VerticalContentAlignment="Center" />
                    <TextBlock Text="단말 용도" Margin="0,10,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="DeviceModeComboBox" Height="30" SelectedValuePath="Tag" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="현장 열람" Tag="viewer" />
                        <ComboBoxItem Content="관리 지원" Tag="admin_support" />
                    </ComboBox>
                    <TextBlock Text="상태" Margin="0,10,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="StatusComboBox" Height="30" SelectedValuePath="Tag" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="사용" Tag="ACTIVE" />
                        <ComboBoxItem Content="비활성" Tag="INACTIVE" />
                        <ComboBoxItem Content="폐기" Tag="RETIRED" />
                    </ComboBox>
                    <TextBlock Text="변경 사유" Margin="0,10,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="ChangeReasonTextBox"
                             Height="56"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="AuditTextBlock"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   Grid.ColumnSpan="3"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</Window>
