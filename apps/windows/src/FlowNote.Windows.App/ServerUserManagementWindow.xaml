<Window x:Class="FlowNote.Windows.App.ServerUserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="서버 계정 관리"
        Width="1080"
        Height="720"
        MinWidth="920"
        MinHeight="650"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Padding="12" Margin="0,0,0,10"
                Background="{StaticResource PanelMutedBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="ModeTextBlock" Text="서버 로그인 계정으로 서버 계정을 관리합니다." TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Width="90" Height="30" Margin="0,0,8,0" Content="새 서버 계정" Click="NewAccountButton_Click" />
                    <Button Width="80" Height="30" Content="새로고침" Click="RefreshButton_Click" />
                </StackPanel>
                <DataGrid x:Name="AccountGrid" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" SelectionChanged="AccountGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="로그인 ID" Binding="{Binding Username}" Width="150" />
                        <DataGridTextColumn Header="사용자 이름" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="역할" Binding="{Binding RoleLabel}" Width="130" />
                        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Padding="14" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="서버 계정 정보" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="사용자 ID" Margin="0,12,0,4" />
                    <TextBox x:Name="UserIdTextBox" Height="30" IsReadOnly="True" />
                    <TextBlock Text="로그인 ID" Margin="0,9,0,4" />
                    <TextBox x:Name="UsernameTextBox" Height="30" IsReadOnly="True" />
                    <TextBlock Text="사용자 이름" Margin="0,9,0,4" />
                    <TextBox x:Name="DisplayNameTextBox" Height="30" />
                    <TextBlock Text="역할" Margin="0,9,0,4" />
                    <ComboBox x:Name="RoleComboBox" Height="30" DisplayMemberPath="Label" SelectedValuePath="Role" />
                    <TextBlock Text="상태" Margin="0,9,0,4" />
                    <ComboBox x:Name="StatusComboBox" Height="30" SelectedValuePath="Tag">
                        <ComboBoxItem Content="활성" Tag="ACTIVE" />
                        <ComboBoxItem Content="잠김" Tag="LOCKED" />
                        <ComboBoxItem Content="비활성" Tag="DISABLED" />
                    </ComboBox>
                    <TextBlock Text="임시 비밀번호" Margin="0,9,0,4" />
                    <PasswordBox x:Name="TemporaryPasswordBox" Height="30" />
                    <TextBlock Text="계정 생성 또는 비밀번호 재설정 때만 입력합니다. 서버는 이 값을 응답이나 이력에 다시 표시하지 않습니다."
                               Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="변경 사유" Margin="0,9,0,4" />
                    <TextBox x:Name="ReasonTextBox" Height="54" TextWrapping="Wrap" AcceptsReturn="True" />
                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                        <Button x:Name="SaveButton" Width="88" Height="32" Margin="0,0,6,6" Content="저장" Click="SaveButton_Click" />
                        <Button x:Name="ResetPasswordButton" Width="112" Height="32" Margin="0,0,6,6" Content="비밀번호 재설정" Click="ResetPasswordButton_Click" />
                        <Button x:Name="RevokeSessionsButton" Width="108" Height="32" Margin="0,0,0,6" Content="세션 강제 폐기" Click="RevokeSessionsButton_Click" />
                    </WrapPanel>
                    <TextBlock Text="활성 세션" Margin="0,10,0,4" FontWeight="SemiBold" />
                    <ListBox x:Name="SessionList" Height="90" DisplayMemberPath="SessionId" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="StatusTextBlock" Margin="2,9,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</Window>
